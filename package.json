{
  "name": "dsh-aris-glass",
  "version": "1.0.0",
  "description": "DSH 液态玻璃插件：给助手（爱丽丝）的消息、左侧栏（会话列表与插件/任务看板等面板行）以及标题栏菜单加一层毛玻璃底色。纯客户端插件，只注入样式表，不改动官方代码。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "liquid-glass",
    "backdrop-filter",
    "theme",
    "css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuelin632/dsh-aris-glass.git"
  },
  "homepage": "https://github.com/xuelin632/dsh-aris-glass#readme",
  "bugs": {
    "url": "https://github.com/xuelin632/dsh-aris-glass/issues"
  },
  "license": "MIT"
}
